#!/bin/sh
# Commits in this repo are attributed to the owner only (see AGENTS.md). Refuse a commit whose author or
# committer is an AI identity, such as the "Claude <noreply@anthropic.com>" default in cloud containers.

ai='anthropic|^claude[[:space:]]|copilot|openai|codex|cursor|gemini|devin|aider'

for role in AUTHOR COMMITTER; do
    ident="$(git var "GIT_${role}_IDENT" 2>/dev/null | sed -E 's/ [0-9]+ [-+][0-9]{4}$//')"
    if printf '%s\n' "$ident" | grep -i -E -q "$ai"; then
        lower="$(printf '%s' "$role" | tr '[:upper:]' '[:lower:]')"
        echo "pre-commit: refusing to commit with $lower \"$ident\"." >&2
        echo "  Commits here are attributed to the repository owner only. For this repo run:" >&2
        echo "    git config user.name \"Shamil\" && git config user.email \"claude.ai@shamil.email\"" >&2
        exit 1
    fi
done

# Packet captures never enter the repo: a tcpdump of the PTP/IP handshake holds GetDeviceInfo with the camera's
# serial, and Init packets and SSDP/mDNS traffic name the Mac. .gitignore drops them under Fixtures/, but
# `git add -f` gets past that, so refuse any staged one, anywhere. Pathspecs ignore core.ignorecase, hence :(icase).
# Any suffix after .pcap or .pcapng (a compressed capture); after .cap only compression suffixes, because
# "<name>.cap.<ext>" is also an ordinary file name (escape.cap.txt).
pcaps="$(git diff --cached --name-only --diff-filter=ACMR -- \
    ':(icase)*.pcap' ':(icase)*.pcapng' ':(icase)*.cap' ':(icase)*.pcap.*' ':(icase)*.pcapng.*' \
    ':(icase)*.cap.gz' ':(icase)*.cap.xz' ':(icase)*.cap.zst' ':(icase)*.cap.bz2' ':(icase)*.cap.lz4' \
    ':(icase)*.cap.lzma' ':(icase)*.cap.z' ':(icase)*.cap.zip' ':(icase)*.cap.7z' ':(icase)*.cap.br')"
if [ -n "$pcaps" ]; then
    echo "pre-commit: refusing to commit packet captures; they carry the camera's serial and the Mac's name:" >&2
    printf '%s\n' "$pcaps" | sed 's/^/  /' >&2
    echo "  Unstage them (git restore --staged <file>), keep them in ~/spike-captures/ outside the checkout, and" >&2
    echo "  write what they show in docs/spike-findings.md. See Fixtures/README.md, Rules." >&2
    exit 1
fi

# The camera's serial number never reaches this public repository (owner's decision, 1 Nov 2026): refuse a staged
# deviceinfo.bin or ssdp-description.xml that still contains one. scripts/redact-fixtures.py zeroes it.
staged="$(git diff --cached --name-only --diff-filter=ACMR -- '*deviceinfo.bin' '*ssdp-description.xml')"
if [ -n "$staged" ]; then
    if ! command -v python3 >/dev/null 2>&1; then
        echo "pre-commit: python3 is needed to check fixtures for the camera's serial number." >&2
        exit 1
    fi
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    script="$(git rev-parse --show-toplevel)/scripts/redact-fixtures.py"
    printf '%s\n' "$staged" | while IFS= read -r f; do
        mkdir -p "$tmp/$(dirname "$f")"
        if ! git show ":$f" > "$tmp/$f" || ! python3 "$script" --check "$tmp/$f"; then
            : > "$tmp/.failed"
        fi
    done
    if [ -e "$tmp/.failed" ]; then
        echo "pre-commit: refusing to commit a fixture with the camera's serial number (see above)." >&2
        exit 1
    fi
fi
exit 0
