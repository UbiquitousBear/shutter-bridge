<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for Shutter Bridge. No tracking and nothing collected: photos go from the camera to this iPhone,
  and staged copies to the person's own iCloud Drive through Apple's service when they choose Stage; nothing reaches
  the developer. The diagnostics export (Settings, Export Diagnostics) is a file made on the iPhone and handed to the
  share sheet; nothing is sent unless the person shares it, so it collects nothing either. The "required reason" APIs
  the app calls, checked against the code on 9 Nov (W19's sweep) and again on 12 Nov (I17: the export and its rolling
  log file, the App Intents, staging and its pending-commit lookup, and the card's free space):
  - UserDefaults (import settings, such as downloads in flight; the destination setting; the proximity reminder's settings,
    holds and snooze; the Wi-Fi cameras' pending list and the Local Network explanation's record): CA92.1, read and
    written only by the app itself.
  - File timestamps of files in the app's container and its iCloud container (sizes and dates of downloads in the work
    folder, of staged copies, including the modification date the pending-commit lookup compares, and of the JPEGs made
    for Copy and Share): C617.1.
  - Disk space (staging PR 7, 12 Nov): before each job starts, the app reads volumeAvailableCapacityForImportantUsage
    of the data volume to check the files fit (E174.1), and a job that can't fit is refused with the free space shown
    to the person (85F4.1). The free space the Cameras screen shows is still the camera's card's, read from the camera
    over PTP with GetStorageInfo, not a disk-space API of the iPhone.
  Not declared, because nothing calls it: system boot time (no uptime or mach_absolute_time call). The App Intents read and start imports through the app's own models and call no
  required-reason API of their own.
  Keep this in step with the code: remove an entry the app stops using and add one for each new required-reason API
  (developer.apple.com, "Describing use of required reason API").
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
				<string>85F4.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
