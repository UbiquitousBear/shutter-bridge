<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for Shutter Bridge. It sits outside the synchronized ShutterBridge/ folder so it isn't copied into the
  app as a resource; the project points at it with INFOPLIST_FILE. Only what the built features need: Iteration 1's keys;
  for the camera's Bluetooth link (Iteration 3, W10), the Bluetooth permission and the bluetooth-central background mode;
  and, for the camera's Wi-Fi (Iteration 3, W12), the Local Network permission. No other background modes until the
  change that uses them. Joining the camera's network needs no key here: it is the Hotspot Configuration entitlement, in
  ShutterBridge.entitlements.
  Left out on purpose: NSBonjourServices (the camera advertised no _ptp._tcp; the app connects to its fixed address,
  backlog section 5) and the ATS NSAllowsLocalNetworking exception (only the SSDP description fetch over plain HTTP would
  need it, and that stays off).
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Shutter Bridge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<!-- From build settings, so CI can set the build number (Xcode Cloud does; each upload needs a new one). -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The launch screen matches the first screen: a navigation bar over the system background (HIG Launching). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UINavigationBar</key>
		<dict/>
	</dict>
	<!-- Portrait and both landscapes (HIG Layout); the strips at the top collapse in compact height. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Only OS-provided cryptography, so TestFlight skips the export compliance questionnaire. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- ImageCaptureCore on iOS reuses the camera privacy string for external cameras. The system's title reads "…Would
	     Like to Access the Camera", so the string says it isn't the iPhone's own (HIG Privacy). -->
	<key>NSCameraUsageDescription</key>
	<string>Shutter Bridge reads photos from a camera you connect by USB-C. It doesn't use this iPhone's cameras.</string>
	<!-- Asked when the app first uses Bluetooth: onboarding's pairing step, or the first Import over Wi-Fi (backlog sections 6
	     and 7). Never at launch: the central is made at launch only once Bluetooth is allowed (BluetoothLaunchRule). -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connects to your camera over Bluetooth to pair with it, and to switch its Wi-Fi on when you import.</string>
	<!-- bluetooth-central with state restoration (decided 9 Nov). Needed from the first central: BluetoothCentral is made
	     with a restore identifier, and Core Bluetooth raises an exception for that without this mode. W17 adds fetch. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<!-- Asked the first time the app connects to the camera over Wi-Fi (port 15740: 192.168.122.1 on the camera's own
	     network after the join, or a typed address), never at launch. Until it is allowed the connection waits; it doesn't
	     fail (backlog section 1). Says why, and that nothing else on the network is touched (HIG Privacy). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to your camera over Wi-Fi to import your photos. It doesn't connect to other devices on your network.</string>
	<!-- Read/write access, as decision 9 asks: albums need it, and Limit Access with no photos selected is enough. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Saves the photos you import into an album. Limit Access with no photos selected is enough.</string>
	<!-- Also what Save Image in the share sheet (Share as JPEG…) asks with, as the share sheet runs in the app. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Saves the photos you import, or a JPEG you share with Save Image, to your library.</string>
	<!-- No once-per-launch "Select More Photos" alert under Limited Access. -->
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<!-- The Files-only path (decision 9): with Photos access denied, imports go to the app's folder in Files. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
